{$ES_DOMAIN} {
	# Caddy obtient/renouvelle automatiquement un certificat Let's Encrypt
	# pour ce domaine — il doit déjà pointer (DNS A record) vers l'IP
	# publique de ce VPS avant de démarrer, sinon la validation ACME échoue.
	reverse_proxy elasticsearch:9200
}

{$ES_DOMAIN}:8443 {
	# Service OCR (docs/roadmap.md item 7) — même nom d'hôte que ci-dessus
	# (le domaine auto-fourni par OVH pour ce VPS), différencié par port
	# plutôt que par sous-domaine : aucun enregistrement DNS supplémentaire
	# requis. À revoir pour un sous-domaine dédié si un vrai nom de domaine
	# est acheté pour le produit.
	reverse_proxy ocr:8080
}
