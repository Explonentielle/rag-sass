# ---------------------------------------------------------------------------
# Supabase (Postgres + Auth + Storage)
# Get these from your Supabase project: Settings > API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-side only, never expose to the browser.
# Used for admin-level operations: background ingestion writes, and reading
# chatbot config for the public chat widget/embed (see lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Elasticsearch
# Local dev default matches docker-compose.yml (security disabled).
# When you switch to a hosted cluster, set URL + username/password
# (or ELASTICSEARCH_API_KEY instead of user/password); no code changes needed.
# ---------------------------------------------------------------------------
ELASTICSEARCH_URL=http://localhost:9201
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=
# Index name prefix, in case you want separate indices per environment.
ELASTICSEARCH_INDEX=documents_chunks

# ---------------------------------------------------------------------------
# OpenAI (embeddings AND chat generation — single-provider billing choice,
# see lib/openai.ts). OPENAI_CHAT_MODEL defaults to the cheapest current
# tier; bump it if answer quality needs to go up.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5.6-luna

# ---------------------------------------------------------------------------
# Anthropic (currently unused — lib/anthropic.ts is kept in the codebase in
# case chat generation moves back to Claude later, but nothing calls it
# right now, so this key isn't required).
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---------------------------------------------------------------------------
# Support widget (floating chat bubble shown on the landing page and in the app)
# Optional: set to a real chatbot's id to enable it. Leave empty to disable.
# See docs/integration.md.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPPORT_CHATBOT_ID=

# ---------------------------------------------------------------------------
# Conversation encryption (lib/crypto.ts, see docs/roadmap.md item 20-C).
# AES-256-GCM key for message content/sources, required — the app throws on
# first read/write if missing. Generate one with `openssl rand -base64 32`
# (or `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`).
# Never commit this value; losing it makes stored conversations unreadable.
# ---------------------------------------------------------------------------
CONVERSATION_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Stripe billing (lib/stripe.ts, see docs/roadmap.md item 17). Groundwork
# only — no Checkout session is created by this app; plans are sold via
# Stripe Payment Links (dashboard-only, no code) and this just keeps
# organizations.plan in sync via the webhook. All optional until you
# actually set up Stripe — see docs/deployment.md for the dashboard steps.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_PME=
STRIPE_PRICE_METIER=

# ---------------------------------------------------------------------------
# Transactional email (lib/email.ts, see docs/roadmap.md item 33). Powers
# the chat's first agentic tool (send_follow_up_email, lib/agenticTools.ts)
# — opt-in per chatbot. Optional: without it, the tool reports a clean
# failure to the model instead of the app crashing. Distinct from the
# Supabase Auth SMTP setup (docs/deployment.md §3) — that's for Supabase's
# own emails (invites, email change), this is our app sending arbitrary
# content directly via Resend's REST API.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# ---------------------------------------------------------------------------
# Cron auth (app/api/cron/purge-conversations/route.ts, docs/roadmap.md item
# 48/20-A). Vercel sends Authorization: Bearer <CRON_SECRET> automatically on
# cron-triggered requests when this is set on the project (Vercel generates
# one for you — Project Settings > Cron Jobs, or set your own). Optional:
# without it, the endpoint has no auth check at all, fine for local dev,
# not for prod once deployed — see docs/deployment.md.
# ---------------------------------------------------------------------------
CRON_SECRET=
