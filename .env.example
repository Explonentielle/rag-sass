# ---------------------------------------------------------------------------
# Supabase (Postgres + Auth + Storage)
# Get these from your Supabase project: Settings > API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side only, never expose to the browser.
# Used for admin-level operations (e.g. background ingestion writes).
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Elasticsearch
# Local dev default matches docker-compose.yml (security disabled).
# When you switch to a hosted cluster, set URL + username/password
# (or ELASTICSEARCH_API_KEY instead of user/password) — no code changes needed.
# ---------------------------------------------------------------------------
ELASTICSEARCH_URL=http://localhost:9201
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=
# Index name prefix, in case you want separate indices per environment.
ELASTICSEARCH_INDEX=documents_chunks

# ---------------------------------------------------------------------------
# OpenAI (embeddings)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Anthropic (chat generation)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Default model used for chat generation. Switch to claude-sonnet-5 for higher quality.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
